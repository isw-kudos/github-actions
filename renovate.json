{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: extractVersion=(?<extractVersion>[^\\s]+))?\\n\\s+[\\w-]+:\\s+(?<currentValue>v?[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.yml$/"
      ],
      "matchStrings": [
        "go install github\\.com/terraform-docs/terraform-docs@(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "terraform-docs/terraform-docs",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchCategories": [
        "python"
      ],
      "groupName": "python dependencies"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false,
      "platformAutomerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "automerge": false,
      "platformAutomerge": false,
      "minimumReleaseAge": "14 days"
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}

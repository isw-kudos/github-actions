{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: extractVersion=(?<extractVersion>[^\\s]+))?\\n\\s+[\\w-]+:\\s+(?<currentValue>v?[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.yml$/"
      ],
      "matchStrings": [
        "go install github\\.com/terraform-docs/terraform-docs@(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "terraform-docs/terraform-docs",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchCategories": [
        "python"
      ],
      "groupName": "python dependencies"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "minimumReleaseAge": null,
      "commitMessageSuffix": "(github-actions)"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "Scope claude-code-review workflow dependency updates",
      "matchFileNames": [".github/workflows/claude-code-review.yml"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "claude-code-review",
      "commitMessageSuffix": ""
    },
    {
      "description": "Scope docker-build workflow dependency updates",
      "matchFileNames": [".github/workflows/docker-build.yml"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "docker-build",
      "commitMessageSuffix": ""
    },
    {
      "description": "Scope ecs-deploy workflow dependency updates",
      "matchFileNames": [".github/workflows/ecs-deploy.yml"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "ecs-deploy",
      "commitMessageSuffix": ""
    },
    {
      "description": "Scope ecs-query dependency updates to ecs-deploy component",
      "matchFileNames": [".github/actions/ecs-query/**"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "ecs-deploy",
      "commitMessageSuffix": ""
    },
    {
      "description": "Scope determine-image-digest workflow dependency updates",
      "matchFileNames": [".github/workflows/determine-image-digest.yml"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "determine-image-digest",
      "commitMessageSuffix": ""
    },
    {
      "description": "Scope tofu-pre-commit workflow dependency updates",
      "matchFileNames": [".github/workflows/tofu-pre-commit.yml"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "tofu-pre-commit",
      "commitMessageSuffix": ""
    },
    {
      "description": "Scope wait-for-required-checks action dependency updates",
      "matchFileNames": [".github/actions/wait-for-required-checks/**"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "wait-for-required-checks",
      "commitMessageSuffix": ""
    },
    {
      "description": "Scope turbo-repo-cache action dependency updates",
      "matchFileNames": [".github/actions/turbo-repo-cache/**"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "turbo-repo-cache",
      "commitMessageSuffix": ""
    },
    {
      "description": "Zizmor - keep the pinned CLI version and the zizmor-action release moving together in ONE PR, gated behind Dependency Dashboard approval and never automerged. zizmor-action ships a support/versions allowlist mapping each exact CLI version to a vetted image digest; its action.sh dies with 'Unknown version' when the version: input is not in the allowlist bundled by the SHA-pinned action release, and the zizmor CLI publishes ahead of the action. Grouping the CLI dep with the action dep makes Renovate propose both in a single branch. See isw-kudos/github-actions .github/workflows/zizmor.yml.",
      "groupName": "Zizmor",
      "matchPackageNames": ["zizmorcore/zizmor", "zizmorcore/zizmor-action"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "dependencyDashboardCategory": "Security tooling"
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
